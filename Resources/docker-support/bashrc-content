alias scan='cd /app && /usr/local/bin/python3 ManageStash.py --scan > /proc/1/fd/1 2>&1'
alias process='cd /app && /usr/local/bin/python3 ManageStash.py --process_files > /proc/1/fd/1 2>&1 && /usr/local/bin/python3 ManageStash.py --garbage > /proc/1/fd/1 2>&1 && /usr/local/bin/python3 ManageStash.py --update_scene_path --path "/61.1_series/61.1.9.import/ongoing_series" > /proc/1/fd/1 2>&1 && /usr/local/bin/python3 ManageStash.py --update_scene_path --path "/61.1_series/61.1.9.import/_old" > /proc/1/fd/1 2>&1'
alias dd='cd /app && /usr/local/bin/python3 ManageStash.py --delete_duplicates_scenes > /proc/1/fd/1 2>&1'
alias ddf='cd /app && /usr/local/bin/python3 ManageStash.py --delete_duplicates_files > /proc/1/fd/1 2>&1'
alias move='cd /app && /usr/local/bin/python3 MoveVideo.py > /proc/1/fd/1 2>&1 && /usr/local/bin/python3 ManageQBittorent.py > /proc/1/fd/1 2>&1'
alias proxy='cd /app && /usr/local/bin/python3 ProxiedScraper.py > /proc/1/fd/1 2>&1'
alias mf='find /app/move_from -mindepth 2 -exec sh -c '\''mv \"$1\" /app/move_to && echo \"Moved: $1\"'\'' _ {} > /proc/1/fd/1 2>&1 \\;'